# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/freepropai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freepropai
DB_USER=username
DB_PASSWORD=password

# Pipeline Database (read-only, optional)
# Set PIPELINE_DB_NAME (reuses DB_HOST/PORT/USER/PASSWORD) to enable /api/pipeline
PIPELINE_DB_NAME=freepropai_db
# Or provide a full connection string, which takes precedence
# PIPELINE_DATABASE_URL=postgresql://username:password@localhost:5432/freepropai_db

# Server Configuration
PORT=3001
NODE_ENV=development

# LLM Configuration (Agentrouter API)
# Get your API key from https://agentrouter.com
# Documentation: https://agentrouter.org/docs/claude-code.html
# IMPORTANT: Use https://agentrouter.org (no /v1 suffix)
ANTHROPIC_API_KEY=your_agentrouter_api_key_here
ANTHROPIC_AUTH_TOKEN=our_agentrouter_api_key_here
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-5

# Alternative: Use standard Anthropic API (if not using agentrouter)
# AGENTROUTER_API_KEY=your_agentrouter_key
# AGENTROUTER_API_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-sonnet-20241022

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Poster images generated by sosmed-agent, served publicly at /posters
# Absolute path to the posters directory on the server
POSTER_BASE_DIR=/absolute/path/to/sosmed-agent/logs/posters
# Optional public origin used to build asset URLs in API responses.
# Leave empty for same-origin relative URLs (recommended behind a proxy).
# PUBLIC_BASE_URL=https://api.example.com

# CORS
CORS_ORIGIN=http://localhost:5173

#MCP CSCORP SETUP
CSCORP_BACKEND_TOKEN=setup_your_token

# LLM Image Generation Config
LLM_MODEL_IMAGE=ag/gemini-3.1-flash-image
LLM_BASE_URL_IMAGE=https://20128-27a8ef7bf11dfea7.monkeycode-ai.live/v1/images/generations
LLM_TOKEN_IMAGE=your_image_llm_token_here

# Listing assets produced by the CSCORP listing agent.
# Pipeline DB stores web-relative paths (assets/listings/x.jpg) that live outside
# this project; server.ts mounts this dir at /assets so the frontend can render
# them. In dev, frontend/public/assets is a symlink to the same dir instead.
ASSETS_BASE_DIR=/home/ceceps/cscorpagent/assets
