# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/freepropai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freepropai
DB_USER=username
DB_PASSWORD=password

# Server Configuration
PORT=3001
NODE_ENV=development

# LLM Configuration (Agentrouter API)
# Get your API key from https://agentrouter.com
# Documentation: https://agentrouter.org/docs/claude-code.html
# IMPORTANT: Use https://agentrouter.org (no /v1 suffix)
ANTHROPIC_API_KEY=your_agentrouter_api_key_here
ANTHROPIC_AUTH_TOKEN=our_agentrouter_api_key_here
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-5

# Alternative: Use standard Anthropic API (if not using agentrouter)
# AGENTROUTER_API_KEY=your_anthropic_api_key_here
# AGENTROUTER_API_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-sonnet-20241022

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173
